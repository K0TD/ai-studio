# Local development only. Copy to apps/demo/.env.local; never commit credentials.
# PostgreSQL and RouterAI are required; no guest balance or successful mock mode.
DATABASE_URL=postgresql://studio:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/studio
ROUTERAI_API_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Use an absolute private path outside public/; production Compose sets /data/media.
MEDIA_ROOT=/tmp/studio-media
QUOTE_MAXIMUM_MULTIPLIER=1.20
