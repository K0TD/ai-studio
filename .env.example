# ==============================================================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ (REQUIRED)
# ==============================================================================
ROUTERAI_API_KEY=sk--your-routerai-api-key
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_this_strong_password_123!
ADMIN_EMAIL=admin@example.com
BETTER_AUTH_SECRET=replace_with_openssl_rand_hex_32_secret
BETTER_AUTH_URL=https://ai-studio.example.com

# ==============================================================================
# СЕТЬ И ВЕБ-СЕРВЕР (NETWORK & DOMAIN)
# ==============================================================================
APP_DOMAIN=ai-studio.example.com
ACME_EMAIL=operator@example.com
APP_PORT=3050

# ==============================================================================
# БАЗА ДАННЫХ (ОПЦИОНАЛЬНО)
# SQLite используется по умолчанию (storage/database/studio.sqlite).
# Для PostgreSQL раскомментируйте строку ниже и запускайте:
# docker compose --profile postgres up -d --build
# ==============================================================================
# DATABASE_URL=postgresql://studio:password@postgres:5432/studio
