# Copy to .env on the VPS; do not commit credentials. chmod 600 .env.
# Required: DNS A/AAAA must resolve to this server; only 80/443 are published.
APP_DOMAIN=studio.example.com
ACME_EMAIL=operator@example.com
BETTER_AUTH_URL=https://studio.example.com
APP_IMAGE_TAG=local

POSTGRES_USER=studio
POSTGRES_DB=studio
# Generate a URL-safe secret: openssl rand -hex 32
POSTGRES_PASSWORD=
# Must match POSTGRES_* above. Percent-encode non-URL-safe password characters.
DATABASE_URL=postgresql://studio:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/studio

# Generate independent secrets; empty values fail preflight.
BETTER_AUTH_SECRET=
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Optional address for the protected administrator account.
ADMIN_EMAIL=
ROUTERAI_API_KEY=
MEDIA_ROOT=/data/media
QUOTE_MAXIMUM_MULTIPLIER=1.20

# Encrypted backups: external repository only, configured before production use.
# Example: s3:https://s3.example.net/studio-backups
RESTIC_REPOSITORY=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=
# Restic encryption password: secrets/restic-password, owner UID 1001, mode 0400.
